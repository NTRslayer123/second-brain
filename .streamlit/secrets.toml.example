# Streamlit Cloud & Local Secrets Configuration
# Rename this file to secrets.toml for local testing, or paste into Streamlit Cloud Dashboard Secrets tab.

# Groq API Key (Get key from https://console.groq.com/keys)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Auto-link vector similarity threshold (default: 0.55)
AUTO_LINK_THRESHOLD = "0.55"
